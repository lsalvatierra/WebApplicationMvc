@model WebApplicationMvc.Models.ImcViewModel
@{
    ViewData["Title"] = "Evaluación del IMC";
}

<div class="container mt-4">
    <div class="row text-center mb-4">
        <h2><i class="bi bi-heart-pulse"></i> Calculadora de Índice de Masa Corporal (IMC)</h2>
        <p class="text-muted">Garantizando el control clínico básico del paciente</p>
    </div>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Datos del Paciente</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Imc" asp-action="Calcular" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Peso" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="Peso" class="form-control" type="number" step="0.1" placeholder="Ej. 72.5" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="Peso" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Talla" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="Talla" class="form-control" type="number" step="0.01" placeholder="Ej. 1.75" />
                                <span class="input-group-text">m</span>
                            </div>
                            <span asp-validation-for="Talla" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="bi bi-calculator"></i> Procesar Diagnóstico
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5 mt-4 mt-md-0">
            @if (ViewData["Procesado"] != null && (bool)ViewData["Procesado"])
            {
                <div class="card shadow-sm border-2">
                    <div class="card-header bg-dark text-white">
                        <h5 class="card-title mb-0">Informe Técnico de Evaluación</h5>
                    </div>
                    <div class="card-body">
                        <p class="fs-5">Paciente: <strong>@Model.Nombre</strong></p>
                        <hr />

                        <div class="text-center my-4">
                            <p class="mb-1 text-muted text-uppercase fw-semibold" style="font-size: 0.85rem;">IMC Calculado</p>
                            <h1 class="display-4 fw-bold text-dark">@Model.ResultadoImc.ToString("F2")</h1>
                        </div>

                        <div class="alert @Model.ClaseCss text-center border-1 py-3 shadow-inner">
                            <h4 class="alert-heading fw-bold mb-1">@Model.Diagnostico</h4>
                            <p class="mb-0 small">El resultado se encuentra dentro de los parámetros establecidos.</p>
                        </div>

                        <div class="mt-4 p-3 border rounded bg-light">
                            <h6 class="fw-bold"><i class="bi bi-info-circle"></i> Nota de Referencia:</h6>
                            <ul class="mb-0 px-3 small text-muted">
                                <li>Bajo peso: Menos de 18.5</li>
                                <li>Normal: 18.5 – 24.9</li>
                                <li>Sobrepeso: 25.0 – 29.9</li>
                                <li>Obesidad: 30.0 a más</li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="h-100 d-flex align-items-center justify-content-center border rounded border-dashed p-5 bg-light">
                    <div class="text-center text-muted">
                        <i class="bi bi-clipboard-pulse display-1 text-secondary"></i>
                        <p class="mt-2 mb-0">Complete el formulario y presione el botón de ejecución para generar los indicadores médicos correspondientes.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

