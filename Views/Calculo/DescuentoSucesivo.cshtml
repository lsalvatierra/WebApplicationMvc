@model WebApplicationMvc.Models.CotizacionViewModel
<h2>Simulador de Descuentos por Campaña</h2>

<div class="row">
    <div class="col-md-5">
        <form asp-action="DescuentoSucesivo" method="post" class="p-3 border rounded bg-light">
            <div class="mb-3">
                <label class="form-label">Nombre del Cliente</label>
                <input asp-for="Cliente" class="form-control" placeholder="Ej. Juan Pérez" />
            </div>
            <div class="mb-3">
                <label class="form-label">Precio del Producto (S/.)</label>
                <input asp-for="PrecioBase" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label class="form-label">Categoría Comercial</label>
                <select asp-for="TipoCliente" class="form-select">
                    <option value="Regular">Regular (0% desc.)</option>
                    <option value="VIP">VIP (10% desc.)</option>
                    <option value="Corporativo">Corporativo (20% desc.)</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success w-100">Calcular Cotización</button>
        </form>
    </div>

    <div class="col-md-7">
        @if (Model.PrecioBase > 0)
        {
            decimal descCategoria = Model.TipoCliente == "VIP" ? 0.10m : (Model.TipoCliente == "Corporativo" ? 0.20m : 0.00m);
            decimal descAdicionalCampaña = 0.05m;

            decimal ahorro1 = Model.PrecioBase * descCategoria;
            decimal precioSubtotal = Model.PrecioBase - ahorro1;
            decimal ahorro2 = precioSubtotal * descAdicionalCampaña;
            decimal precioFinal = precioSubtotal - ahorro2;

            <div class="card border-info">
                <div class="card-header bg-info text-white">Resumen de Totales para @Model.Cliente</div>
                <div class="card-body">
                    <ul class="list-group">
                        <li class="list-group-item">Precio Inicial: <b>S/ @Model.PrecioBase.ToString("F2")</b></li>

                        @if (descCategoria > 0)
                        {
                            <li class="list-group-item text-danger">Descuento por Tipo (@Model.TipoCliente): -S/ @ahorro1.ToString("F2")</li>
                        }

                        <li class="list-group-item text-danger">Descuento Campaña Web (5%): -S/ @ahorro2.ToString("F2")</li>
                        <li class="list-group-item list-group-item-success fs-5">
                            <b>Precio Neto a Pagar: S/ @precioFinal.ToString("F2")</b>
                        </li>
                    </ul>

                    <div class="mt-3 text-muted small">
                        * Los descuentos aplicados son sucesivos sobre saldo neto de operación.
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center">
                Ingrese los valores en el formulario de la izquierda para procesar los cálculos.
            </div>
        }
    </div>
</div>
